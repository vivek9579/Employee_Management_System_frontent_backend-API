@model List<DepartmentDTO>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container-fluid">
    <div class="row justify-content-between">
        <div class="card-header bg-black justify-content-between align-items-center d-flex">
            <h3 class="text-light"> Department List </h3>
            <a class="btn btn-light btn-sm" asp-controller="Department" asp-action="Create"> <i class="fa-solid fa-circle-plus"></i> Cretae Department </a>
        </div>
        <div class="col-12 col-md-11 col-lg-12 shadow align-content-center">

            <div class="table-responsive card-body">
                <table class=" table-bordered table table-striped text-center table-hover">
                    <thead>
                        <tr style="background-color:rgba(1,0,0,0.1)">
                            <th>Id</th>
                            <th> DepartmentName </th>
                            <th> Created Date</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.CreateDate</td>
                                <td>@item.IsActive</td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pencil"></i> Edit</a>
                                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash-can-arrow-up"></i> Delete</a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>