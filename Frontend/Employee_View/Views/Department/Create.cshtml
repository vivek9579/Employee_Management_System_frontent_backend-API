@model DepartmentDTO
<div class="container">
    <div class="row justify-content-center mt-4">
    <div class="col-md-6 shadow mt-4">
       <form asp-action="Create" method="post">
           <div class="form-group">
               <label class=""> Department Name </label>
               <input asp-for="Name" class="form-control" placeholder="Enter Department Name" type="text"/>
                    <span asp-validation-for="Name" class="text-danger mt-2 mb-2"></span>
           </div>
                <div class="form-group">
                    <label class=""> Date </label>
                    <input asp-for="CreateDate " class="form-control"  type="date" />
                    <span asp-validation-for="CreateDate" class="text-danger mt-2 mb-2"></span>
                </div>
                <button class="btn btn-success w-100 mt-2 mb-2"> Submit</button>
       </form>
            <a class="btn btn-secondary w-100 mt-2 mb-4" asp-action="Index" asp-controller="Department">Back to Home</a>
    </div>
    </div>
</div>