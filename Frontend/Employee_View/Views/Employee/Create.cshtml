@model EmployeeDTO
<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-6 shadow mt-4">
            <form asp-action="Create" asp-controller="Employee" method="post">
                <div class="form-group">
                    <label class="form-label">  Name </label>
                    <input asp-for="Name" class="form-control" placeholder="Enter Name" type="text" />
                    <span asp-validation-for="Name" class="text-danger mt-2 mb-2"></span>
                </div>

                <div class="form-group">
                    <label class="form-label"> Email Address </label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com"/>
                    <span asp-validation-for="Email" class="text-danger mt-2 mb-2"></span>
                </div>

                <div class="form-group">
                    <label class="form-label"> Mobile Number </label>
                    <input asp-for="Mobile" class="form-control"/>
                    <span asp-validation-for="Mobile" class="text-danger mt-2 mb-2"></span>
                </div>

                <div class="form-group">
                    <label class="form-label"> Salary </label>
                    <input asp-for="Salary" class="form-control" />
                    <span asp-validation-for="Salary" class="text-danger mt-2 mb-2"></span>
                </div>

                <div class="form-group">
                    <label class="form-label"> Department Name </label>
                   <select asp-for="DepartmentId" class="form-control form-select">
                       <option> ..... Select Department ..... </option>
                       @foreach(var item in Model.Departments)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger mt-2 mb-2"></span>
                </div>

                <button class="btn btn-success w-100 mt-2 mb-2"> Submit</button>
            </form>
            <a class="btn btn-secondary w-100 mt-2 mb-4" asp-action="Index">Back to Home</a>
        </div>
    </div>
</div>