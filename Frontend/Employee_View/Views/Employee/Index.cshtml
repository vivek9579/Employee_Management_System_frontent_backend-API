@* @model List<EmployeeDTO> *@
@* @{
    bool asc = Model.Select(x => x.Asc).FirstOrDefault();
} *@
@model EmployeeQueryDTO
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container-fluid">
    <div class="row justify-content-between">
        <div class="card-header bg-black justify-content-between align-items-center d-flex">
            <h3 class="text-light"> Employee List </h3>
            <form method="get">
                <input value="@Context.Request.Query["search"]" type="text" name="search" />
                <button type="submit">Search</button>
            </form>
            <a class="btn btn-light btn-sm" asp-controller="Employee" asp-action="Create"> <i class="fa-solid fa-circle-plus"></i> Cretae Employee </a>
        </div>
        <div class="col-12 col-md-11 col-lg-12 shadow align-content-center">

            <div class="table-responsive card-body">
                <table class=" table-bordered table table-striped text-center table-hover">
                    <thead>
                        <tr style="background-color:rgba(1,0,0,0.1)">
                            <th>
                                <a asp-action="Index" asp-route-sorting="Id"
                                   asp-route-asc="@(!Model.Asc)">Id </a>
                            </th>
                            <th> Name </th>
                            <th>Email</th>
                            <th>Mobile Number</th>
                            <th> Salary </th>
                            <th> Status </th>
                            <th> Created Date</th>
                            <th>Deparment</th>
                            <th>Update Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Employees)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.Mobile</td>
                                <td>@item.Salary</td>
                                <td>@item.IsActive</td>
                                <td>@item.CreatedDate</td>
                                <td>@item.DepartmentName</td>
                                <td>@item.UpdatedDate</td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-controller="Employee" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pencil"></i> Edit</a>
                                    <a class="btn btn-danger btn-sm" asp-controller="Employee" asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash-can-arrow-up"></i> Delete</a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@{
    int startPage = ((Model.Page - 1) / 2 * 2 + 1);
    int endpage = Math.Min(startPage + 1, Model.TotalPages);
    if(Model.Page>1)
    {
        <a asp-action="Index" asp-route-Page="@(Model.Page - 1)" asp-route-PageSize="@(Model.PageSize)"
        class="btn btn-success m-1 align-items-center"> <i class="fa-solid fa-angles-left"></i></a>
    }
  for(int i = startPage; i <= endpage; i++)
    {
        <a asp-action="Index" asp-route-Page="@i" asp-route-PageSize="@(Model.PageSize)" 
        class="btn @(Model.Page == i ? "btn-primary" : "btn-secondry") m-1"> @i</a>
    }
    if(Model.Page<Model.TotalPages)
    {
        <a asp-action="Index" asp-route-Page="@(Model.Page + 1)" asp-route-PageSize="@(Model.PageSize)"
           class="btn btn-danger m-1 align-items-center"> <i class="fa-solid fa-angles-right"></i></a>
    }
}
<script>
    @if (TempData["eror"] != null)
    {
      <text> showMessage('@TempData["eror"]'); </text>
    }
    function showMessage(message)
    {
        alert(message);
    }
</script>